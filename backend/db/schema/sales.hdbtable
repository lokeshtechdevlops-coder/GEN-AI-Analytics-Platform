COLUMN TABLE "SALES_ANALYTICS" (
    "OrderID" INTEGER,
    "OrderDate" DATE,
    "Year" INTEGER,
    "Quarter" NVARCHAR(10),
    "MonthNum" INTEGER,
    "MonthName" NVARCHAR(20),
    "MonthLabel" NVARCHAR(20),
    "Category" NVARCHAR(100),
    "Subcategory" NVARCHAR(100),
    "ProductID" NVARCHAR(50),
    "ProductName" NVARCHAR(200),
    "UnitOfMeasure" NVARCHAR(20),
    "Region" NVARCHAR(100),
    "Country" NVARCHAR(100),
    "IndustryVertical" NVARCHAR(100),
    "CustomerID" NVARCHAR(50),
    "CustomerName" NVARCHAR(200),
    "CustomerSegment" NVARCHAR(100),
    "SalesRegion" NVARCHAR(100),
    "SalesOffice" NVARCHAR(100),
    "SalesRepID" NVARCHAR(50),
    "SalesRepName" NVARCHAR(200),
    "SalesRepRole" NVARCHAR(100),
    "Channel" NVARCHAR(50),
    "OrderType" NVARCHAR(50),
    "OrderStatus" NVARCHAR(50),
    "PaymentTerms" NVARCHAR(50),
    "Quantity" INTEGER,
    "UnitListPriceUSD" DECIMAL(15,2),
    "DiscountPercent" DECIMAL(5,2),
    "NetUnitPriceUSD" DECIMAL(15,2),
    "NetRevenueUSD" DECIMAL(15,2),
    "UnitCostUSD" DECIMAL(15,2),
    "TotalCostUSD" DECIMAL(15,2),
    "GrossMarginUSD" DECIMAL(15,2),
    "GrossMarginPercent" DECIMAL(5,2),
    "TransactionCurrency" NVARCHAR(10),
    "FXRateToUSD" DECIMAL(10,4),
    "NetRevenueLocalCurrency" DECIMAL(15,2),
    PRIMARY KEY ("OrderID")
);
