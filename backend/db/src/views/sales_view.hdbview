VIEW "SALES_ANALYTICS_VIEW" AS 
SELECT 
    "OrderID",
    "OrderDate",
    "Year",
    "Quarter",
    "MonthNum",
    "MonthName",
    "Category",
    "Subcategory",
    "ProductName",
    "Region",
    "Country",
    "IndustryVertical",
    "CustomerName",
    "CustomerSegment",
    "SalesRepName",
    "Channel",
    "OrderStatus",
    "Quantity",
    "UnitListPriceUSD",
    "DiscountPercent",
    "NetUnitPriceUSD",
    "NetRevenueUSD",
    "UnitCostUSD",
    "TotalCostUSD",
    "GrossMarginUSD",
    "GrossMarginPercent",
    "TransactionCurrency",
    "FXRateToUSD",
    "NetRevenueLocalCurrency"
FROM "SALES_ANALYTICS";
